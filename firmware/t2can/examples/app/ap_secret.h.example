// Copy this file to "ap_secret.h" (same directory) and set your own values.
// ap_secret.h is git-ignored, so real credentials never reach the repository.
//
//     cp ap_secret.h.example ap_secret.h
//
// Without it the build falls back to the placeholders in app.ino and warns.
// There is no screen or reset button on this board, so whatever you set here
// is what you will need to join the AP -- write it down somewhere.
//
// Give each board a distinct SSID if more than one may be powered at once;
// otherwise a phone connects to whichever it happens to see first.
#pragma once

#define AP_SSID_OVERRIDE "VanCompanion"
#define AP_PASS_OVERRIDE "change-me"      // 8+ characters, WPA2
